-- === LOGIC GAMEPLAY (ĐÃ FIX LỖI RUNG + CHẠY TẠI CHỖ) ===
local function ResetCamera()
    spectateTarget = nil
    pcall(function()
        if Player.Character and Player.Character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = Player.Character.Humanoid
        end
    end)
end

local function StopFollowing()
    followTarget = nil
    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end
end

local function StartFollowing(player)
    StopFollowing()
    followTarget = player
    
    followConnection = RunService.Heartbeat:Connect(function(deltaTime)
        local myChar = Player.Character
        local tChar = followTarget and followTarget.Character
        
        if myChar and tChar then
            local myRoot = myChar:FindFirstChild("HumanoidRootPart")
            local tRoot = tChar:FindFirstChild("HumanoidRootPart")
            local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
            
            if myRoot and tRoot then
                -- FIX LỖI CHẠY TẠI CHỖ: Triệt tiêu gia tốc chuyển động vật lý và vận tốc gốc
                myRoot.Velocity = Vector3.new(0, 0, 0)
                myRoot.RotVelocity = Vector3.new(0, 0, 0)
                if myHumanoid then
                    myHumanoid:Move(Vector3.new(0, 0, 0)) -- Buộc dừng di chuyển hoạt ảnh đi bộ
                end
                
                local targetCFrame = tRoot.CFrame
                
                if followMode == "Sau lưng" then
                    targetCFrame = targetCFrame * CFrame.new(0, 0, followDistance)
                elseif followMode == "Trước mặt" then
                    targetCFrame = targetCFrame * CFrame.new(0, 0, -followDistance) * CFrame.fromEulerAnglesXYZ(0, math.rad(180), 0)
                elseif followMode == "Bên trái" then
                    -- FIX RUNG MÁY KHOAN: Giữ nguyên độ cao Y ổn định và dùng điểm nhìn cố định chính xác
                    local leftPos = (tRoot.CFrame * CFrame.new(-followDistance, 0, 0)).Position
                    targetCFrame = CFrame.lookAt(leftPos, tRoot.Position)
                elseif followMode == "Bên phải" then
                    -- FIX RUNG MÁY KHOAN: Giữ nguyên độ cao Y ổn định và dùng điểm nhìn cố định chính xác
                    local rightPos = (tRoot.CFrame * CFrame.new(followDistance, 0, 0)).Position
                    targetCFrame = CFrame.lookAt(rightPos, tRoot.Position)
                elseif followMode == "Bên trên" then
                    targetCFrame = targetCFrame * CFrame.new(0, followDistance, 0) * CFrame.fromEulerAnglesXYZ(math.rad(-90), 0, 0)
                elseif followMode == "Bên dưới" then
                    targetCFrame = targetCFrame * CFrame.new(0, -followDistance, 0) * CFrame.fromEulerAnglesXYZ(math.rad(90), 0, 0)
                elseif followMode == "Xoay tròn" then
                    rotationAngle = rotationAngle + (deltaTime * rotateSpeed)
                    local offsetX = math.sin(rotationAngle) * followDistance
                    local offsetZ = math.cos(rotationAngle) * followDistance
                    targetCFrame = CFrame.lookAt(tRoot.Position + Vector3.new(offsetX, 0, offsetZ), tRoot.Position)
                end
                
                -- Áp dụng vị trí mượt mà tuyệt đối
                myRoot.CFrame = targetCFrame
            end
        else
            StopFollowing()
            RefreshMenu()
        end
    end)
end

function RefreshMenu()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    local count = 0
    local allPlayers = Players:GetPlayers()
    
    for _, p in ipairs(allPlayers) do
        count = count + 1
        
        local itemFrame = Instance.new("Frame")
        itemFrame.Size = UDim2.new(1, -6, 0, 28)
        itemFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        itemFrame.BorderSizePixel = 0
        itemFrame.Parent = scrollFrame
        
        if p == Player then
            itemFrame.LayoutOrder = 0
            itemFrame.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
        else
            itemFrame.LayoutOrder = 1
        end
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, -70, 1, 0)
        nameLabel.Position = UDim2.new(0, 4)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.Gotham
        nameLabel.TextSize = 10
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.Parent = itemFrame
        
        if p == Player then
            nameLabel.Text = "[Tôi] " .. p.Name
            nameLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
            nameLabel.Font = Enum.Font.GothamBold
        else
            nameLabel.Text = p.Name
            nameLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
        end
        
        local specBtn = Instance.new("TextButton")
        specBtn.Size = UDim2.new(0, 30, 0, 20)
        specBtn.Position = UDim2.new(1, -66, 0, 4)
        specBtn.BorderSizePixel = 0
        specBtn.Text = "Xem"
        specBtn.TextSize = 9
        specBtn.Font = Enum.Font.GothamBold
        specBtn.Parent = itemFrame
        
        if (spectateTarget == p) or (p == Player and spectateTarget == nil) then
            specBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
            specBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            specBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            specBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        
        local followBtn = Instance.new("TextButton")
        followBtn.Size = UDim2.new(0, 30, 0, 20)
        followBtn.Position = UDim2.new(1, -34, 0, 4)
        followBtn.BorderSizePixel = 0
        followBtn.TextSize = 9
        followBtn.Font = Enum.Font.GothamBold
        followBtn.Parent = itemFrame
        
        if p == Player then
            followBtn.Text = "X"
            followBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            followBtn.TextColor3 = Color3.fromRGB(100, 100, 100)
        else
            followBtn.Text = "Đuôi"
            if followTarget == p then
                followBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                followBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                followBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                followBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
            end
        end
        
        specBtn.MouseButton1Click:Connect(function()
            if p == Player then
                ResetCamera()
            else
                if spectateTarget == p then
                    ResetCamera()
                else
                    spectateTarget = p
                    local function setCam()
                        if spectateTarget == p and p.Character and p.Character:FindFirstChild("Humanoid") then
                            Camera.CameraSubject = p.Character.Humanoid
                        end
                    end
                    setCam()
                    p.CharacterAdded:Connect(setCam)
                end
            end
            RefreshMenu()
        end)
        
        if p ~= Player then
            followBtn.MouseButton1Click:Connect(function()
                if followTarget == p then
                    StopFollowing()
                else
                    StartFollowing(p)
                end
                RefreshMenu()
            end)
        end
    end
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

