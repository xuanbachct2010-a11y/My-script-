function PlaySoundRemote(Name, Volume)
    local Volume = Volume or 1
    local args = {
        [1] = Name,
        [2] = game:GetService("Players").LocalPlayer.Character.Humanoid
    }
    for i = 1, Volume do
        spawn(function()
            ReplicatedStorage.PlaySoundRemote:InvokeServer(unpack(args))
        end)
    end
end

